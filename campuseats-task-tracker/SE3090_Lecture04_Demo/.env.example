# ============================================================================
#  SE3090 Lecture 04 - EXAMPLE environment file        (SLIDE 23)
#
#  1. Copy this file to ".env"          cp .env.example .env
#  2. Put YOUR real values in ".env"
#  3. ".env" is in .gitignore and must NEVER be committed.
#
#  IMPORTANT: ASP.NET Core reads ENVIRONMENT VARIABLES, not .env files - there
#  is no library in this project that parses one. So either export the values
#  yourself, or use the recommended route, "dotnet user-secrets" (README step 4).
#
#      macOS / Linux :  set -a; source .env; set +a; dotnet run
#      Windows (PS)  :  Get-Content .env | ForEach-Object {
#                         if ($_ -match '^([^#=]+)=(.*)$') {
#                           [Environment]::SetEnvironmentVariable($matches[1], $matches[2])
#                         } }
#
#  This file (.env.example) IS committed, on purpose: it documents which
#  variables a teammate needs without revealing a single real value.
#  That is the industry pattern - copy it into your assignment repository.
#
#  NOTE on the double underscore: ASP.NET Core reads "__" as ":" so
#  ConnectionStrings__LankaMartDb  ==  ConnectionStrings:LankaMartDb
#  in appsettings.json. Same key, different source.
# ============================================================================

# --- The database (SLIDE 23) ------------------------------------------------
# Use the least-privilege application user, NEVER the postgres superuser.
# Add SslMode=Require for any database that is not on your own machine.
ConnectionStrings__LankaMartDb=Host=localhost;Port=5432;Database=lankamart;Username=lankamart_app;Password=CHANGE_ME

# --- JWT signing key (SLIDE 33: "Weak / leaked secret") ---------------------
# Must be at least 32 characters. Generate a real random one, do not type words:
#   Linux/macOS : openssl rand -base64 48
#   Windows PS  : [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
Jwt__SigningKey=CHANGE_ME_generate_a_long_random_key_at_least_32_chars

# --- Optional overrides -----------------------------------------------------
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7
LankaMart__DeliveryFee=350
